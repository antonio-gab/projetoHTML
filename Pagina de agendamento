<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agendamento de Consulta</title>
</head>
<body>
    <a>
        <h2>
            Agendamento de Consulta
        </h2>

     <label for="nome">Nome do Paciente:<span>*</span></label><br>
    <input type="text" id="nome" name="nome" required placeholder="Digite o nome do paciente">
    
    <br><br>

     <label for="data de nascimento">Data de Nascimento:<span>*</span></label><br>
     <input type="text" id="data de nascimento" name="data de nascimento" required placeholder="Digite a data de nascimento">
    <br><br>

     <label for="cpf">CPF:<span>*</span></label><br>
    <input type="text" id="cpf" name="cpf" required placeholder="Digite seu CPF">
    
    <br><br>

    <a>
        <h2>
            Data e Horário da Consulta
        </h2>

    <label for="data da consulta">Data da Consulta:<span>*</span></label><br>
    <input type="date" id="data da consulta" name="data da consulta" required placeholder="Digite a data da consulta">
    <br><br>

    <label for="horario da consulta">Horário da Consulta:<span>*</span></label><br>
    <input type="time" id="horario da consulta" name="horario da consulta" required placeholder="Digite o horário da consulta">
    <br><br>

    <a>
        <h2>
            Médico Responsável
        </h2>
    </a>
    <label for="tipo de consulta">Médico Responsável:<span>*</span></label><br>
    <select id="tipo de consulta" name="tipo de consulta" required>
        <option value="">Selecione o Médico Responsável</option>
        <option value="consulta1">Dr.Luan Pereira</option>
        <option value="consulta2">Dr. Ze Felipe</option>
        <option value="consulta3">Dra. Virginia</option>
     <br><br>

    <button type= "submit" class= "btn-primary-entrar" onclick = "return false;">Agendar Consulta </button> <br>

    
</body>
</html>
